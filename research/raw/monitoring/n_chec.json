:[{"country":"United States","submissionId":20070028555,"endDate":"2006-10-11T00:00:00.0000000+00:00","sponsors":[{"organizationId":"25a83722425e49a5b461d57f994a61ad","meta":{"organization":{"name":"International BioMEMS and Nanotech World","location":"United States"}},"meetingId":"7fb5ed4f8ce84ed2b8c39bb46a5ae6cc","id":"ce6c623be5d74e8ebc4eec9170e48b6a"}],"name":"Digital Health Conference: Integrated Health Care","location":"Baltimore, MD","id":"7fb5ed4f8ce84ed2b8c39bb46a5ae6cc","startDate":"2006-10-10T00:00:00.0000000+00:00"}],"publications":[{"submissionId":20070028555,"id":"1af4d749902a4c5e81b85f5213e02298","publicationDate":"2007-10-10T00:00:00.0000000+00:00"}],"status":"CURATED","related":[],"downloads":[],"downloadsAvailable":false,"index":"submissions-2026-11-12-06-24"},{"_meta":{"score":212.36053},"copyright":{"thirdPartyPermissionsProduced":false,"disclosedToPublic":false,"containsIndication":false,"publisherPermissionOrRightsToDistribute":false,"belongsToUsGov":false,"determinationType":"PUBLIC_USE_PERMITTED","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"submissionId":20110011351,"containsThirdPartyMaterial":false,"belongsToPublisher":false,"id":"100b7f9b55e54eaf95857a55a1307347","belongsToAuthors":false},"subjectCategories":["Aerospace Medicine"],"exportControl":{"isExportControl":"NO","submissionId":20110011351,"ear":"NO","id":"4500c3c692b142a2ac057a096c2de4c4","itar":"NO"},"distributionDate":"2019-07-11T00:00:00.0000000+00:00","otherReportNumbers":["JSC-CN-23601","Report Number: JSC-CN-23601"],"title":"Crew Health Care System (CHeCS) Design Research, Documentations, and Evaluations","stiType":"OTHER","distribution":"PUBLIC","submittedDate":"2013-08-25T07:51:00.0000000+00:00","authorAffiliations":[{"sequence":0,"submissionId":20110011351,"meta":{"author":{"name":"CLement, Bethany M."},"organization":{"name":"Georgia Inst. of Tech.","location":"Atlanta, GA, United States"}},"id":"f7f1cf3bcfb6466bb44fb212e40f3522"}],"stiTypeDetails":"Other","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2025-08-31T18:39:21.7150190+00:00","id":20110011351,"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":""},"created":"2013-08-25T07:51:00.0000000+00:00","center":{"code":"JSC","name":"Johnson Space Center","id":"dd46994b91a94cb2a2722617cbbadc55"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"The Crew Health Care System (CHeCS) is a group within the Space Life Science Directorate (SLSD) that focuses on the overall health of astronauts by reinforcing the three divisions - the Environmental Maintenance System (EMS), the Countermeasures System (CMS), and the Health Maintenance System (HMS). This internship provided opportunity to gain knowledge, experience, and skills in CHeCS engineering and operations tasks. Various and differing tasks allowed for occasions to work independently, network to get things done, and show leadership abilities. Specific exercises included reviewing hardware certification, operations, and documentation within the ongoing Med Kit Redesign (MKR) project, and learning, writing, and working various common pieces of paperwork used in the engineering and design process. Another project focused on the distribution of various pieces of hardware to off-site research facilities with an interest in space flight health care. The main focus of this internship, though, was on a broad and encompassing understanding of the engineering process as time was spent looking at each individual step in a variety of settings and tasks.","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","publications":[{"submissionId":20110011351,"id":"3c1f5bc7308e443a8cd40e20f84bf4fa","publicationDate":"2011-03-01T00:00:00.0000000+00:00"}],"status":"CURATED","related":[],"downloads":[{"draft":false,"mimetype":"application/pdf","name":"20110011351.pdf","type":"STI","links":{"original":"/api/citations/20110011351/downloads/20110011351.pdf","pdf":"/api/citations/20110011351/downloads/20110011351.pdf","fulltext":"/api/citations/20110011351/downloads/20110011351.txt"}}],"downloadsAvailable":true,"index":"submissions-2026-11-12-06-24"},{"_meta":{"score":204.54807},"copyright":{"thirdPartyPermissionsProduced":false,"disclosedToPublic":false,"containsIndication":false,"publisherPermissionOrRightsToDistribute":false,"belongsToUsGov":false,"determinationType":"GOV_PUBLIC_USE_PERMITTED","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"submissionId":20090032068,"containsThirdPartyMaterial":false,"belongsToPublisher":false,"id":"ec3e15ce3cd246f79ec4b2ff888b0f1b","belongsToAuthors":false},"subjectCategories":["Aerospace Medicine"],"exportControl":{"isExportControl":"NO","submissionId":20090032068,"ear":"NO","id":"7beb8ea2e38240ae8ffb6969ea8e410a","itar":"NO"},"distributionDate":"2019-07-17T00:00:00.0000000+00:00","title":"Developing Crew Health Care and Habitability Systems for the Exploration Vision","stiType":"ABSTRACT","distribution":"PUBLIC","submittedDate":"2013-08-24T18:55:00.0000000+00:00","authorAffiliations":[{"sequence":0,"submissionId":20090032068,"meta":{"author":{"name":"Laurini, Kathy"},"organization":{"name":"NASA Johnson Space Center","location":"Houston, TX, United States"}},"id":"869cf7e64c0d4c7f97c48192277fd049"},{"sequence":1,"submissionId":20090032068,"meta":{"author":{"name":"Sawin, Charles F."},"organization":{"name":"NASA Johnson Space Center","location":"Houston, TX, United States"}},"id":"ed8263d365f1468eb5eec9cec647d9e8"}],"stiTypeDetails":"Abstract","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2025-08-31T18:39:21.7150190+00:00","id":20090032068,"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":""},"created":"2013-08-24T18:55:00.0000000+00:00","center":{"code":"JSC","name":"Johnson Space Center","id":"dd46994b91a94cb2a2722617cbbadc55"},"onlyAbstract":true,"sensitiveInformation":2,"abstract":"This paper will discuss the specific mission architectures associated with the NASA Exploration Vision and review the challenges and drivers associated with developing crew health care and habitability systems to manage human system risks. Crew health care systems must be provided to manage crew health within acceptable limits, as well as respond to medical contingencies that may occur during exploration missions. Habitability systems must enable crew performance for the tasks necessary to support the missions. During the summer of 2005, NASA defined its exploration architecture including blueprints for missions to the moon and to Mars. These mission architectures require research and technology development to focus on the operational risks associated with each mission, as well as the risks to long term astronaut health. This paper will review the highest priority risks associated with the various missions and discuss NASA s strategies and plans for performing the research and technology development necessary to manage the risks to acceptable levels.","isLessonsLearned":false,"disseminated":"METADATA_ONLY","meetings":[{"submissionId":20090032068,"name":"Institute for Space and Nuclear Power Studies","location":"Albuquerque, NM, United States","id":"1d6299b937e84d26b375095a2dec006f"},{"country":"United States","submissionId":20090032068,"endDate":"2006-02-16T00:00:00.0000000+00:00","sponsors":[{"meta":{"organization":{"name":"Institute for Space and Nuclear Power Studies","location":"Albuquerque, NM, United States"}},"meetingId":"1e12bc3884f947d2ac89c78fd4a1aa9a","id":"cabf6b25cfac48c0973826c8b8fb3cb1"}],"name":"STAIF 2006 Conference","location":"Albuquerque, NM","id":"1e12bc3884f947d2ac89c78fd4a1aa9a","startDate":"2006-02-12T00:00:00.0000000+00:00"}],"publications":[{"submissionId":20090032068,"id":"a1514e396bf74fc7bcd91f2d00fda52f","publicationDate":"2006-02-11T00:00:00.0000000+00:00"}],"status":"CURATED","related":[],"downloads":[],"downloadsAvailable":false,"index":"submissions-2026-11-12-06-24"},{"_meta":{"score":193.25717},"copyright":{"thirdPartyPermissionsProduced":false,"disclosedToPublic":false,"containsIndication":false,"publisherPermissionOrRightsToDistribute":false,"belongsToUsGov":false,"determinationType":"OTHER","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"submissionId":19860038763,"containsThirdPartyMaterial":false,"belongsToPublisher":false,"id":"7564b386aee94e74831da571ba9d7852","belongsToAuthors":false},"subjectCategories":["Astronautics (General)"],"exportControl":{"isExportControl":"NO","submissionId":19860038763,"ear":"NO","id":"1d03b59cff1b482ab4bd1d77e07896f6","itar":"NO"},"distributionDate":"2019-06-24T00:00:00.0000000+00:00","otherReportNumbers":["SAE PAPER 851310","Report Number: SAE PAPER 851310"],"title":"Preparing a health care delivery system for Space Station","stiType":"CONFERENCE_PAPER","distribution":"PUBLIC","submittedDate":"2013-08-12T19:29:00.0000000+00:00","authorAffiliations":[{"sequence":0,"submissionId":19860038763,"meta":{"author":{"name":"Logan, J. S."},"organization":{"name":"NASA Johnson Space Center","location":"Houston, TX, United States"}},"id":"e15a1984df0e4f14a7ee5f4014684fe6"},{"sequence":1,"submissionId":19860038763,"meta":{"author":{"name":"Stewart, G. R."},"organization":{"name":"GE Management and Technical Services Co.","location":"Houston, TX, United States"}},"id":"8c64f9e1a1d04edab15b6ab436fe0161"}],"stiTypeDetails":"Conference Paper","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2025-08-31T18:39:21.7150190+00:00","id":19860038763,"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":"86A23501"},"created":"2013-08-12T19:29:00.0000000+00:00","center":{"code":"CDMS","name":"Legacy CDMS","id":"092d6e0881874968859b972d39a888dc"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"NASA's Space Station is viewed as the beginning of man's permanent presence in space. This paper presents the guidelines being developed by NASA's medical community in preparing a quality, permanent health care delivery system for Space Station. The guidelines will be driven by unique Space Station requirements such as mission duration, crew size, orbit altitude and inclination, EVA frequency and rescue capability. The approach will emphasize developing a health care system that is modular and flexible. It will also incorporate NASA's requirements for growth capability, commonality, maintainability, and advanced technology development. Goals include preventing unnecessary rescue attempts, as well as maintaining the health and safety of the crew. Proper planning will determine the levels of prevention, diagnosis, and treatment necessary to achieve these goals.","isLessonsLearned":false,"disseminated":"METADATA_ONLY","publications":[{"submissionId":19860038763,"id":"0fc9059dc19c4055aa84e56387d492a4","publicationDate":"1985-07-01T00:00:00.0000000+00:00"}],"status":"CURATED","related":[],"downloads":[],"downloadsAvailable":false,"index":"submissions-2026-11-12-06-24"},{"_meta":{"score":188.1259},"copyright":{"thirdPartyPermissionsProduced":false,"disclosedToPublic":false,"containsIndication":false,"publisherPermissionOrRightsToDistribute":false,"belongsToUsGov":false,"determinationType":"OTHER","thirdPartyContentCondition":"NOT_SET","belongsToContractor":false,"disclosedInvention":false,"submissionId":20060020705,"containsThirdPartyMaterial":false,"belongsToPublisher":false,"id":"a3fba77de6964ccfaf6a39fc2aa9660f","belongsToAuthors":false},"subjectCategories":["Aerospace Medicine"],"exportControl":{"isExportControl":"NO","submissionId":20060020705,"ear":"NO","id":"2275b39993884fd19d7810a75b118bc5","itar":"NO"},"distributionDate":"2019-07-12T00:00:00.0000000+00:00","otherReportNumbers":["SAE-2006-01-2060","Report Number: SAE-2006-01-2060"],"fundingNumbers":[{"number":"769-06-01-01-01","submissionId":20060020705,"id":"e0e007e6373f4108b7114e5e47c38073","