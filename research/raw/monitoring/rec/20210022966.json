 United States"}},"id":"fd028484b0ce4e69ac311230e63f1db3","userType":"OTHER"},{"organizationId":"184389ee78e05dd8ab6050cafbb52187","sequence":9,"submissionId":20210022966,"meta":{"author":{"name":"Christopher Jones"},"organization":{"name":"University of Pennsylvania","location":"Philadelphia, Pennsylvania, United States"}},"id":"b30e5afa8f424f0dad5299b4939a5da6","userType":"OTHER"},{"organizationId":"184389ee78e05dd8ab6050cafbb52187","sequence":10,"submissionId":20210022966,"meta":{"author":{"name":"Kia Howard"},"organization":{"name":"University of Pennsylvania","location":"Philadelphia, Pennsylvania, United States"}},"id":"a55363db7bf94f0b9ace9f1f8386e324","userType":"OTHER"},{"organizationId":"184389ee78e05dd8ab6050cafbb52187","sequence":11,"submissionId":20210022966,"meta":{"author":{"name":"Marc Kaizi-Lutu"},"organization":{"name":"University of Pennsylvania","location":"Philadelphia, Pennsylvania, United States"}},"id":"2c5fe694b10e49b0ae52bed0bd465e98","userType":"OTHER"},{"organizationId":"184389ee78e05dd8ab6050cafbb52187","sequence":12,"submissionId":20210022966,"meta":{"author":{"orcidId":"","name":"David F Dinges"},"organization":{"name":"University of Pennsylvania","location":"Philadelphia, Pennsylvania, United States"}},"id":"bdb7287750704ababc4ec59f69078531","userType":"CONTRACTOR_GRANTEE","userId":"cc751c694b914e79977b5ff12ce902bd"},{"organizationId":"184389ee78e05dd8ab6050cafbb52187","sequence":13,"submissionId":20210022966,"meta":{"author":{"name":"Haochung Shou "},"organization":{"name":"University of Pennsylvania","location":"Philadelphia, Pennsylvania, United States"}},"id":"ca14f131c11943e1b94b0792b146372d","userType":"OTHER"}],"stiTypeDetails":"Technical Publication (TP)","technicalReviewType":"SINGLE_EXPERT","modified":"2025-08-31T18:39:21.7150190+00:00","id":20210022966,"created":"2021-10-18T17:20:40.8487170+00:00","center":{"code":"JSC","name":"Johnson Space Center","id":"dd46994b91a94cb2a2722617cbbadc55"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"Astronauts are exposed to a unique set of stressors in spaceflight. Microgravity, isolation, confinement, and environmental and operational hazards: all of these can impact sleep, vigilant attention, and alertness, which are critical to mission success. In this paper, we seek to understand the most important predictors of alertness over the course of a space mission, using self-reported, cognitive, and environmental data collected from 24 astronauts on 6-month missions to the International Space Station (ISS). Alertness was repeatedly and objectively assessed on the ISS with a brief 3-minute Psychomotor Vigilance Test (PVT) that is highly sensitive to sleep deprivation. To relate PVT performance to time-varying and sparsely-measured environmental, operational, and psychological covariates, we propose a n ensemble prediction model comprising of linear mixed effects regression, random forest, and functional concurrent regression models. An extensive cross-validation procedure reveals that this ensemble outperforms any one of its components   alone. We also discover that a participant’s past performance, reported fatigue and stress, and temperature and radiation exposure were among the most important variables associated with alertness. This method is broadly applicable to environmental studies where the main goal is accurate, individualized prediction involving a mixture of person-level traits and irregularly measured time series.","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","cui":{"isCui":false,"submissionId":20210022966,"id":"5d226606ccbc409eacebc373849985df"},"meetings":[{"country":"US","submissionId":20210022966,"name":"","location":"","id":"852579fc3385461381a512db00176c7d"}],"publications":[{"submissionId":20210022966,"id":"74068c90d8e74e1b8252f9e533c0337d","publicationName":"","publicationDate":"2021-11-20T06:00:00.0000000+00:00"}],"status":"CURATED","related":[],"downloads":[{"draft":false,"mimetype":"application/pdf","name":"Final Tu et al TRISH_Updated_2021-11-12.pdf","type":"STI","links":{"original":"/api/citations/20210022966/downloads/Final%20Tu%20et%20al%20TRISH_Updated_2021-11-12.pdf","pdf":"/api/citations/20210022966/downloads/Final%20Tu%20et%20al%20TRISH_Updated_2021-11-12.pdf","fulltext":"/api/citations/20210022966/downloads/Final%20Tu%20et%20al%20TRISH_Updated_2021-11-12.pdf.txt"}}],"downloadsAvailable":true,"index":"submissions-2026-11-12-06-24"}