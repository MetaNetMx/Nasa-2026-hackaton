., Inc.","location":"Houston, TX, United States"}},"id":"a287ef120adc469db872352881d6b5cd"},{"sequence":3,"submissionId":20190001886,"meta":{"author":{"name":"Boley, Lynn Addy"},"organization":{"name":"Wyle Integrated Science and Engineering Group","location":"Houston, TX, United States"}},"id":"cc2400bb1a6a4ab29d08f7f8a9e9ee6f"},{"sequence":4,"submissionId":20190001886,"meta":{"author":{"name":"Goodenow, Debra A."},"organization":{"name":"NASA Glenn Research Center","location":"Cleveland, OH, United States"}},"id":"bd9dee5b6c994858becdb3bc9ea17cb0"},{"sequence":5,"submissionId":20190001886,"meta":{"author":{"name":"Kerstman, Eric Lee"},"organization":{"name":"Wyle Labs., Inc.","location":"Houston, TX, United States"}},"id":"0f594caa69ec4e49b281351db7de5eb7"},{"sequence":6,"submissionId":20190001886,"meta":{"author":{"name":"Koslovsky, M."},"organization":{"name":"Wyle Labs., Inc.","location":"Houston, TX, United States"}},"id":"6ffd54908db14741a508e4d1cc6a8dd7"},{"sequence":7,"submissionId":20190001886,"meta":{"author":{"name":"Reyes, David Paul"},"organization":{"name":"Wyle Labs., Inc.","location":"Houston, TX, United States"}},"id":"f70173ca447f4db095cb3c92fb6bb2a0"},{"sequence":8,"submissionId":20190001886,"meta":{"author":{"name":"Saile, Lynn"},"organization":{"name":"Wyle Labs., Inc.","location":"Houston, TX, United States"}},"id":"9b8901ccb1c14990970debd1c2674ea5"},{"sequence":9,"submissionId":20190001886,"meta":{"author":{"name":"Taiym, Wafa F."},"organization":{"name":"Wyle Labs., Inc.","location":"Houston, TX, United States"}},"id":"7c28cb1c23014caf916f590ffc9f51a1"},{"sequence":10,"submissionId":20190001886,"meta":{"author":{"name":"Young, Millennia H."},"organization":{"name":"NASA Johnson Space Center","location":"Houston, TX, United States"}},"id":"671a6b91d6b5417a8b3d1b133fe33923"}],"stiTypeDetails":"Presentation","technicalReviewType":"TECHNICAL_REVIEW_TYPE_NONE","modified":"2025-08-31T18:39:21.7150190+00:00","id":20190001886,"legacyMeta":{"__type":"LegacyMetaIndex, StrivesApi.ServiceModel","accessionNumber":""},"created":"2019-03-26T10:52:13.3830000+00:00","center":{"code":"GRC","name":"Glenn Research Center","id":"19eeb25fa404421d9eaa5f876e853e3c"},"onlyAbstract":false,"sensitiveInformation":2,"abstract":"The Human Research Program funded the development of the Integrated Medical Model (IMM) to quantify the medical component of overall mission risk. The IMM uses Monte Carlo simulation methodology, incorporating space flight and ground medical data, to estimate the probability of mission medical outcomes and resource utilization. To determine the credibility of IMM output, the IMM project team completed two validation studies that compared IMM predicted output to observed medical events from a selection of Shuttle Transportation System (STS) and International Space Station (ISS) missions. The validation study results showed that the IMM underpredicted the occurrence of ~10% of the modeled medical conditions for the STS missions and overpredicted ~20% of the modeled medical conditions for the ISS missions. These findings imply that the strength of IMM predictions to inform decisions depends on simulated mission specifications including length. This discrepancy could result from medical recording differences between ISS and STS that possibly influence observed incidence rates, IMM combining all \"mission type\" data as constant occurrence rate or fixed proportion across both mission types, misspecification of symptoms to conditions, and gaps in the literature informing the model. Some of these issues will be alleviated by updating the IMM source data through incorporation of the observed validation data.","isLessonsLearned":false,"disseminated":"DOCUMENT_AND_METADATA","meetings":[{"country":"United States","submissionId":20190001886,"endDate":"2018-09-21T00:00:00.0000000+00:00","sponsors":[{"organizationId":"cffc4da6863a4b5aa1439ab77e6c29ac","meta":{"organization":{"name":"International Association for PSAM","location":"IA, United States"}},"meetingId":"d441b1dd2b0e4ce28c8611d827970aa5","id":"9a8beceff2584453827c34a40fc54b2c"}],"name":"Probabilistic Safety Assessment and Management (PSAM 14)","location":"Los Angeles, CA","id":"d441b1dd2b0e4ce28c8611d827970aa5","startDate":"2018-09-16T00:00:00.0000000+00:00"}],"publications":[{"submissionId":20190001886,"id":"a8583ff2304a4b38b591df7069081e26","publicationDate":"2018-09-16T00:00:00.0000000+00:00"}],"status":"CURATED","related":[],"downloads":[{"draft":false,"mimetype":"application/pdf","name":"20190001886.pdf","type":"STI","links":{"original":"/api/citations/20190001886/downloads/20190001886.pdf","pdf":"/api/citations/20190001886/downloads/20190001886.pdf","fulltext":"/api/citations/20190001886/downloads/20190001886.txt"}}],"downloadsAvailable":true,"index":"submissions-2026-11-12-06-24"}